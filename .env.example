# RIG-02 RTSP Stream Manager configuration.
# Production: copy to /etc/rtsp-manager/rtsp-manager.env (mode 0640, root:rtspmgr).
# Every setting is optional except RTSPM_PUBLIC_RTSP_HOST. Full list: backend/app/config.py

# ---- Network ---------------------------------------------------------------
# Fixed DNS name or reserved IP that laptops and the 5.x edge use to reach this
# server. Only used to DISPLAY rtsp:// URLs. Do not leave as localhost.
RTSPM_PUBLIC_RTSP_HOST=rig02.example.internal
RTSPM_PUBLIC_RTSP_PORT=8554
# Other names/IPs that users on other subnets or the VPN use for this server
# (comma list). Offered in the dashboard's "URLs use" picker and URL exports.
# RTSPM_RTSP_ALT_HOSTS=10.8.0.5,rig02-vpn.example.internal
# RTSPM_ADDRESS_CHECK_INTERVAL_S=60

# ---- Remote access (Cloudflare Tunnel + Access) ------------------------------
# Requests that arrive through Cloudflare without a valid Access token are
# refused (403), also while these are empty. See docs/DEPLOYMENT.md.
# RTSPM_CF_ACCESS_TEAM=acme                 # <team>.cloudflareaccess.com
# RTSPM_CF_ACCESS_AUD=<Access application AUD tag>
# RTSPM_CF_ACCESS_MODE=tunnel               # or "all": LAN needs a token too
# TUNNEL_TOKEN=<tunnel token>               # docker compose --profile cloudflare
# Local MediaMTX endpoints (keep on loopback)
RTSPM_PUBLISH_RTSP_BASE=rtsp://127.0.0.1:8554
RTSPM_MEDIAMTX_API_URL=http://127.0.0.1:9997

# ---- Storage ---------------------------------------------------------------
RTSPM_VIDEO_DIR=/data/rtsp-manager/videos
RTSPM_DATA_DIR=/var/lib/rtsp-manager
# RTSPM_LOG_DIR=/var/log/rtsp-manager
RTSPM_FRONTEND_DIST=/opt/rtsp-manager/frontend/dist

# ---- MediaMTX control: systemd | process | external -------------------------
RTSPM_MEDIAMTX_CONTROL=systemd
RTSPM_MEDIAMTX_SERVICE_NAME=mediamtx.service
RTSPM_MEDIAMTX_AUTO_RECOVER=true
# process mode only (development):
# RTSPM_MEDIAMTX_BIN=mediamtx
# RTSPM_MEDIAMTX_CONFIG=/path/to/mediamtx.yml

# ---- Capacity -----------------------------------------------------------------
RTSPM_MAX_ACTIVE_STREAMS=20
RTSPM_MAX_TRANSCODE_STREAMS=4
RTSPM_CPU_WARN_PERCENT=80
RTSPM_MEM_WARN_PERCENT=85

# ---- Start spacing (edge de-duplication) ---------------------------------------
# Every camera start waits until the previous one is on air + this many seconds,
# so the edge never gets the same frame from two cameras at once. 0 = off.
RTSPM_START_SPACING_S=2.0
# Move on if a start does not come on air within this many seconds.
RTSPM_START_READY_WAIT_S=5
# Extra content gap kept between cameras of the same video (on top of the spacing).
RTSPM_START_PHASE_MARGIN_S=0.25

# ---- Lead-in (slate before the video) -------------------------------------------
# Default for NEW streams: none | fixed (slate for N s) | hold (until a viewer + N s)
RTSPM_DEFAULT_LEAD_IN_MODE=fixed
RTSPM_DEFAULT_LEAD_IN_S=5
# Optional font for the slate text (default: fontconfig's, e.g. DejaVu Sans)
# RTSPM_SLATE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ---- Codec policy (confirm against the 5.x edge, see docs/EDGE_VALIDATION.md) --
# auto: copy compatible H.264, transcode the rest | never: refuse | always
RTSPM_TRANSCODE_POLICY=auto
RTSPM_COPY_CODECS=h264
RTSPM_COPY_PIX_FMTS=yuv420p,yuvj420p
RTSPM_COPY_PROFILES=Constrained Baseline,Baseline,Main,High
RTSPM_MAX_WIDTH=3840
RTSPM_MAX_HEIGHT=2160
RTSPM_MAX_FPS=60
RTSPM_X264_PRESET=veryfast
RTSPM_X264_PROFILE=high
RTSPM_X264_GOP_SECONDS=2
RTSPM_TRANSCODE_MAX_WIDTH=1920
RTSPM_TRANSCODE_MAX_HEIGHT=1080
RTSPM_OUTPUT_FPS_MODE=passthrough

# ---- Publishers ----------------------------------------------------------------
# Keep publishers running while the backend restarts/upgrades and re-adopt them
# (cameras on the edge are not interrupted). Loop playlists last 7 days.
RTSPM_KEEP_PUBLISHERS_ON_RESTART=true
RTSPM_LOOP_PLAYLIST_HOURS=168

# ---- Alerts and monitoring -----------------------------------------------------
# Teams / Slack incoming webhook (or any URL accepting JSON {"text": ...}).
# RTSPM_ALERT_WEBHOOK_URL=https://...
RTSPM_ALERT_MIN_INTERVAL_S=300
# Link included in alert messages
# RTSPM_DASHBOARD_URL=https://rig02.example.internal/
RTSPM_NET_WARN_MBPS=400
# Prometheus: scrape /api/metrics with Basic auth (a viewer account is enough).

# ---- Uploads -------------------------------------------------------------------
RTSPM_UPLOAD_MAX_BYTES=68719476736
RTSPM_DISK_RESERVE_BYTES=5368709120
RTSPM_DISK_RESERVE_PERCENT=5
RTSPM_UPLOAD_SESSION_IDLE_S=3600
# Deleted videos are moved to <video_dir>/.trash and purged after this many days
RTSPM_TRASH_DAYS=7

# ---- Access control ------------------------------------------------------------
# No login by default: anyone who can reach the server has full access.
# Set to true for accounts, roles and protected streams (manage_users.py creates the first admin).
RTSPM_AUTH_ENABLED=false
# RTSPM_USERS_FILE=/var/lib/rtsp-manager/users   (manage with scripts/manage_users.py)
# RTSPM_SECRET_KEY=   (default: generated into <data_dir>/secret_key)
RTSPM_SESSION_HOURS=12
# RTSPM_COOKIE_SECURE=true   (set automatically by install.sh --tls)
# Roles: admin (users + everyone's protected streams), operator, viewer.
