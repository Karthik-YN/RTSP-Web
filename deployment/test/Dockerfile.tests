# Runs the backend test suite against a distro's own FFmpeg (Linux validation).
#   docker build -f deployment/test/Dockerfile.tests --build-arg BASE=debian:12 -t rig02-test:debian12 .
ARG BASE=debian:12
FROM ${BASE}
ARG MEDIAMTX_VERSION=v1.21.2
ENV DEBIAN_FRONTEND=noninteractive PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      ffmpeg python3 python3-venv curl ca-certificates procps iproute2 >/dev/null \
 && rm -rf /var/lib/apt/lists/*
RUN arch=$(dpkg --print-architecture) && case "$arch" in amd64) a=amd64;; arm64) a=arm64;; *) exit 1;; esac \
 && curl -fsSL -o /tmp/m.tgz "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_${a}.tar.gz" \
 && tar -xzf /tmp/m.tgz -C /usr/local/bin mediamtx && rm /tmp/m.tgz
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN python3 -m venv backend/.venv && backend/.venv/bin/pip install -q -r backend/requirements.txt
COPY . .
RUN useradd -m tester && chown -R tester /app
USER tester
CMD ["sh", "-c", "ffmpeg -hide_banner -version | head -1 && backend/.venv/bin/pytest -q -p no:cacheprovider"]
